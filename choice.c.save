#include <stdio.h>
int main()
{
  int choice, a, b;
  int sum, diff, prod;
  printf("Enter 2 numbers: ");
  scanf("%d %d", &a, &b);

  printf("Enter a choice to do:\n 1.sum\n 2.difference\n 3.product\n: ");
  scanf("%d", &choice);

  if (choice == 1)
    sum = a + b;
    printf("Sum of A  and B: %d", sum);
  else if (choice == 2)
    if (a > b)
      diff = a - b;
    else
      diff = b - a;
    printf("Difference of A  and B: %d", diff);
  else if (choice == 3)
    prod = a*b;
    printf("Product of A and B: %d", prod);
  else
   printf("Invalid choice");

   return 0;
}
